{
  "manifest_version": 3,
  "name": "Google Form PDF Saver",
  "version": "1.0.0",
  "description": "Adds a 'Save answers as PDF' button to Google Forms so respondents can download their answers locally — no data ever leaves the browser.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": [
        "lib/jspdf.umd.min.js",
        "src/selectors.js",
        "src/extractor.js",
        "src/state.js",
        "src/pdf.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
